# Authentication (Required)
# Generate password hash: node -e "require('bcrypt').hash('your-password', 12).then(console.log)"
DASHBOARD_PASSWORD_HASH=$2b$12$...your-bcrypt-hash-here...

# Encryption (Required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-string-here-for-aes-256-encryption
